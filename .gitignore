# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
pvdata

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

tea_debug.log

# Local credentials scratch (never commit)
massive.toml

# Local scratch dir (samples, dumps)
tmp/

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

.DS_Store
.thumbs.db
node_modules

# Frontend build output (keep placeholder for go:embed)
web/ui/dist/*
!web/ui/dist/index.html

# Configuration
public/config.json

# Quasar core related directories
.quasar
/dist
/quasar.config.*.temporary.compiled*

# Cordova related directories and files
/src-cordova/node_modules
/src-cordova/platforms
/src-cordova/plugins
/src-cordova/www

# Capacitor related directories and files
/src-capacitor/www
/src-capacitor/node_modules

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln

# local .env files
.env.local*
.vite/

# Worktrees
.worktrees/
go1.24.2.linux-arm64.tar.gz

# Claude Code per-machine state (scheduled task locks, local settings).
.claude/
